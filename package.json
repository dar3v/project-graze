{
  "name": "project-graze",
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "typecheck": "cf workers types && tsc && tsc -p apps/web && tsc -p packages/sim",
    "test": "node --experimental-strip-types --test packages/features/test/*.test.ts packages/sim/herd/test/*.test.ts apps/web/test/*.test.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "web:build": "vite build --config apps/web/vite.config.ts",
    "web:preview": "vite preview --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "hono": "5.0.0-rc.1",
    "svelte": "^5.57.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@hono/cli": "^1.0.0-rc.8",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^24.19.2",
    "cf": "^1.0.0-beta.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
